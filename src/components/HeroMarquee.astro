---
import { siteContent } from "../content/site";

const chips = siteContent.hero.marquee;
const loop = [...chips, ...chips];
---

<div
  class="marquee-viewport overflow-hidden border-y border-accent-dim/30 bg-bg-alt/60 py-3"
  aria-hidden="true"
>
  <div class="marquee-track flex w-max whitespace-nowrap">
    {
      loop.map((chip, i) => (
        <span
          class="hud-label flex items-center gap-6 px-6 text-xs text-text-dim"
          data-i18n={`hero.marquee.${i % chips.length}`}
        >
          {chip.pt}
          <span class="text-accent">//</span>
        </span>
      ))
    }
  </div>
</div>

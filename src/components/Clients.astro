---
import { siteContent } from "../content/site";
import SectionHeading from "./ui/SectionHeading.astro";

const { clients, sections } = siteContent;
---

<section id="clients" class="mx-auto max-w-6xl px-6 py-24" aria-labelledby="clients-heading">
  <div data-reveal-group>
    <SectionHeading
      id="clients-heading"
      index={sections.clients.index}
      eyebrow={sections.clients.eyebrow}
      eyebrowPath="sections.clients.eyebrow"
      heading={sections.clients.heading}
      headingPath="sections.clients.heading"
    />

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {
        clients.map((client) => {
          const hasLogo = client.logoSrc !== "TODO";
          return (
            <div
              class={`flex aspect-video items-center justify-center rounded border px-4 py-3 text-center opacity-60 grayscale transition-all duration-200 hover:border-accent-dim hover:opacity-100 hover:grayscale-0 ${
                client.invertOnHover ? "hover:invert" : ""
              } ${hasLogo ? "border-accent-dim/40" : "border-dashed border-accent-dim/40"}`}
              data-reveal
            >
              {hasLogo ? (
                <img
                  src={client.logoSrc}
                  alt={client.name}
                  width="160"
                  height="90"
                  class="max-h-full max-w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="hud-label text-[10px] text-text-dim">{client.name}</span>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

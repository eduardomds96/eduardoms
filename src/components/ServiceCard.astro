---
import type { ServiceItem } from "../content/site";
import { siteContent } from "../content/site";
import CrosshairCorners from "./ui/CrosshairCorners.astro";

interface Props {
  service: ServiceItem;
  index: number;
}

const { service, index } = Astro.props;
const { servicesUi } = siteContent;
---

<div class="group glow-border relative rounded-lg p-6 transition-transform duration-200 hover:scale-[1.02]" data-reveal>
  <CrosshairCorners />

  <h3 class="text-xl font-semibold text-text" data-i18n={`services.${index}.title`}>
    {service.title.pt}
  </h3>
  <p class="mt-2 text-sm text-text-dim" data-i18n={`services.${index}.summary`}>
    {service.summary.pt}
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      service.tags.map((tag) => (
        <span class="hud-label rounded border border-accent-dim/50 px-2 py-0.5 text-[10px] text-text-dim">
          {tag}
        </span>
      ))
    }
  </div>

  <details class="mt-4">
    <summary class="hud-label flex cursor-pointer items-center gap-1 text-xs text-accent">
      <span data-i18n="servicesUi.viewScope">{servicesUi.viewScope.pt}</span>
      <span aria-hidden="true">→</span>
    </summary>
    <p class="mt-3 text-sm text-text-dim" data-i18n={`services.${index}.scope`}>
      {service.scope.pt}
    </p>
  </details>
</div>

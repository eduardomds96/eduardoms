---
import { siteContent } from "../content/site";
import SectionHeading from "./ui/SectionHeading.astro";
import ServiceCard from "./ServiceCard.astro";

const { services, sections } = siteContent;
---

<section id="services" class="mx-auto max-w-6xl px-6 py-24" aria-labelledby="services-heading">
  <div data-reveal-group>
    <SectionHeading
      id="services-heading"
      index={sections.services.index}
      eyebrow={sections.services.eyebrow}
      eyebrowPath="sections.services.eyebrow"
      heading={sections.services.heading}
      headingPath="sections.services.heading"
    />

    <div class="grid gap-6 md:grid-cols-3">
      {services.map((service, index) => <ServiceCard service={service} index={index} />)}
    </div>
  </div>
</section>
